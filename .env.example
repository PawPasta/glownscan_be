GLOWNSCAN_BACKEND_URL=http://localhost:3000
GLOWNSCAN_FRONTEND_URL=http://localhost:5173

GLOWNSCAN_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

GLOWNSCAN_DATABASE_POOL_MAX=10
GLOWNSCAN_DATABASE_CONNECT_TIMEOUT_MS=5000
GLOWNSCAN_DATABASE_QUERY_TIMEOUT_MS=15000
GLOWNSCAN_DATABASE_STATEMENT_TIMEOUT_MS=15000
GLOWNSCAN_DATABASE_IDLE_TIMEOUT_MS=30000

# Generate a unique random value of at least 32 characters for each environment.
GLOWNSCAN_JWT_ACCESS_SECRET=your-jwt0-access-secret
GLOWNSCAN_ACCESS_TOKEN_TTL_SECONDS=900
GLOWNSCAN_REFRESH_TOKEN_TTL_DAYS=30
# Set distinct values for each deployment environment.
GLOWNSCAN_JWT_ISSUER=glownscan-api
GLOWNSCAN_JWT_AUDIENCE=glownscan-client

# SMTP settings used for verification and password-reset email.
GLOWNSCAN_SMTP_HOST=your-smtp-host
GLOWNSCAN_SMTP_PORT=587
GLOWNSCAN_SMTP_SECURE=false
GLOWNSCAN_SMTP_USER=your-smtp-user
GLOWNSCAN_SMTP_PASSWORD=your-smtp-password
GLOWNSCAN_SMTP_FROM=your-smtp-from
GLOWNSCAN_EMAIL_VERIFY_PATH=/verify-email
GLOWNSCAN_PASSWORD_RESET_PATH=/reset-password

# Cloudinary server-side API credentials used to sign avatar upload intents.
GLOWNSCAN_CLOUDINARY_CLOUD_NAME=user-cloudinary-cloud-name
GLOWNSCAN_CLOUDINARY_API_KEY=your-cloudinary-api-key
GLOWNSCAN_CLOUDINARY_API_SECRET=user-cloudinary-api-secret

# Gemini server-side API settings. Keep the API key in .env.local or a deployment
# secret store; never commit real credentials.
GLOWNSCAN_GEMINI_API_KEY=your-gemini-api-key
GLOWNSCAN_GEMINI_MODEL=gemini-2.5-flash
GLOWNSCAN_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

GLOWNSCAN_ANALYSIS_DAILY_QUOTA_FREE=3
GLOWNSCAN_ANALYSIS_DAILY_QUOTA_PREMIUM=30
GLOWNSCAN_ANALYSIS_MAX_CONCURRENT_PER_USER=1
GLOWNSCAN_ANALYSIS_MAX_CONCURRENT_GLOBAL=10
GLOWNSCAN_ANALYSIS_RESERVATION_TTL_SECONDS=180
GLOWNSCAN_ANALYSIS_IMAGE_MAX_BYTES=10485760
GLOWNSCAN_ANALYSIS_IMAGE_DOWNLOAD_TIMEOUT_MS=30000


# Used by `npm run db:bootstrap-admin` and internal-payment refunds. Never commit real credentials.
# `GLOWNSCAN_ADMIN_EMAI` is retained for compatibility with existing deployment configuration.
GLOWNSCAN_ADMIN_EMAIL=admin@example.com
GLOWNSCAN_ADMIN_EMAI=admin@example.com
GLOWNSCAN_ADMIN_PASSWORD=badword

# Firebase
GLOWNSCAN_FIREBASE_PROJECT_ID=your-firebase-project-id

# SEPAY
GLOWNSCAN_SEPAY_WEBHOOK_SECRET=...
GLOWNSCAN_SEPAY_BANK_ACCOUNT_NUMBER=...
GLOWNSCAN_BANK_ACCOUNT_NAME=...
GLOWNSCAN_BANK_BIN=970423
GLOWNSCAN_PAYMENT_ORDER_TTL_MINUTES=15
