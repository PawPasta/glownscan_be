GLOWNSCAN_BACKEND_URL=http://localhost:3000
GLOWNSCAN_FRONTEND_URL=http://localhost:5173

GLOWNSCAN_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Generate a unique random value of at least 32 characters for each environment.
GLOWNSCAN_JWT_ACCESS_SECRET=your-jwt0-access-secret
GLOWNSCAN_ACCESS_TOKEN_TTL_SECONDS=900
GLOWNSCAN_REFRESH_TOKEN_TTL_DAYS=30

# SMTP settings used for verification and password-reset email.
GLOWNSCAN_SMTP_HOST=your-smtp-host
GLOWNSCAN_SMTP_PORT=587
GLOWNSCAN_SMTP_SECURE=false
GLOWNSCAN_SMTP_USER=your-smtp-user
GLOWNSCAN_SMTP_PASSWORD=your-smtp-password
GLOWNSCAN_SMTP_FROM=your-smtp-from
GLOWNSCAN_EMAIL_VERIFY_PATH=/verify-email
GLOWNSCAN_PASSWORD_RESET_PATH=/reset-password

# Cloudinary server-side API credentials used to sign avatar upload intents.
GLOWNSCAN_CLOUDINARY_CLOUD_NAME=user-cloudinary-cloud-name
GLOWNSCAN_CLOUDINARY_API_KEY=your-cloudinary-api-key
GLOWNSCAN_CLOUDINARY_API_SECRET=user-cloudinary-api-secret

# Gemini server-side API credentials. Keep the API key in .env.local or a
GLOWNSCAN_GEMINI_API_KEY=
GLOWNSCAN_GEMINI_MODEL=gemini-2.5-flash

# Used only by `npm run db:bootstrap-admin`; never committed with real credentials.
GLOWNSCAN_ADMIN_EMAIL=admin@example.com
GLOWNSCAN_ADMIN_PASSWORD=badword

# Firebase
GLOWNSCAN_FIREBASE_PROJECT_ID=your-firebase-project-id