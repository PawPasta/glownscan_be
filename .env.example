GLOWNSCAN_BACKEND_URL=http://localhost:3000
GLOWNSCAN_FRONTEND_URL=http://localhost:5173

GLOWNSCAN_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Generate a unique random value of at least 32 characters for each environment.
GLOWNSCAN_JWT_ACCESS_SECRET=
GLOWNSCAN_ACCESS_TOKEN_TTL_SECONDS=900
GLOWNSCAN_REFRESH_TOKEN_TTL_DAYS=30

# SMTP settings used for verification and password-reset email.
GLOWNSCAN_SMTP_HOST=
GLOWNSCAN_SMTP_PORT=587
GLOWNSCAN_SMTP_SECURE=false
GLOWNSCAN_SMTP_USER=
GLOWNSCAN_SMTP_PASSWORD=
GLOWNSCAN_SMTP_FROM=
GLOWNSCAN_EMAIL_VERIFY_PATH=/verify-email
GLOWNSCAN_PASSWORD_RESET_PATH=/reset-password

# Used only by `npm run db:bootstrap-admin`; never committed with real credentials.
GLOWNSCAN_ADMIN_EMAIL=admin@example.com
GLOWNSCAN_ADMIN_PASSWORD=